{
  "name": "@collab/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./monitoring": {
      "types": "./dist/monitoring.d.ts",
      "import": "./dist/monitoring.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:monitoring": "node scripts/monitoring-smoke.ts"
  },
  "dependencies": {
    "@collab/shared": "workspace:*",
    "@sentry/node": "11.5.0",
    "redis": "6.3.0"
  },
  "devDependencies": {
    "@collab/config": "workspace:*",
    "@types/node": "24.19.1",
    "typescript": "6.0.3"
  }
}
