{
  "name": "@collab/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "generate": "node --env-file-if-exists=../../.env ./node_modules/prisma/build/index.js generate",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.tooling.json",
    "migrate": "node --env-file=../../.env ./node_modules/prisma/build/index.js migrate dev",
    "migrate:deploy": "node --env-file=../../.env ./node_modules/prisma/build/index.js migrate deploy",
    "migrate:status": "node --env-file=../../.env ./node_modules/prisma/build/index.js migrate status",
    "studio": "node --env-file=../../.env ./node_modules/prisma/build/index.js studio --port 5555 --browser none",
    "verify": "node --env-file=../../.env scripts/verify-database.ts",
    "auth:schema": "auth generate --config ./scripts/auth-schema.ts --adapter prisma --dialect postgresql --output ./prisma/auth.generated.prisma --yes"
  },
  "dependencies": {
    "@collab/shared": "workspace:*",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0"
  },
  "devDependencies": {
    "@collab/config": "workspace:*",
    "@types/node": "24.19.1",
    "auth": "1.7.7",
    "better-auth": "1.7.7",
    "prisma": "7.10.0",
    "typescript": "6.0.3"
  }
}
