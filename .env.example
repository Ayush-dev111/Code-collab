# PostgreSQL connection string (Neon, Supabase or a local install).
DATABASE_URL=postgresql://user:password@host:5432/collab

# The exact URL people open in the browser.
BETTER_AUTH_URL=http://127.0.0.1:3000
# Generate with: node -p "require('node:crypto').randomBytes(32).toString('hex')"
BETTER_AUTH_SECRET=replace_with_a_random_secret_of_at_least_32_characters

# Optional Better Auth hosted dashboard (dash.better-auth.com).
BETTER_AUTH_API_KEY=

# Optional sign-in providers. Callback: <BETTER_AUTH_URL>/api/auth/callback/<provider>
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Code runs on Paiza.io's free sandbox with its public "guest" key.
# Optional: your own Paiza API key.
PAIZA_API_KEY=

# Optional: PORT=3000, HOST=127.0.0.1
