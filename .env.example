# Local development only; change credentials before deploying.
POSTGRES_USER=collab
POSTGRES_PASSWORD=collab_dev_password
POSTGRES_DB=collab
POSTGRES_PORT=5432
REDIS_PORT=6379
DATABASE_URL=postgresql://collab:collab_dev_password@127.0.0.1:5432/collab?schema=public
REDIS_URL=redis://127.0.0.1:6379
# Phase 8: optional error tracking; leave DSNs blank to disable it.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ENVIRONMENT=development
# Optional source-map upload credentials; used only during builds.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
# Phase 6: server-only sandbox endpoint and independent generated credentials.
# Leave JUDGE0_URL and JUDGE0_AUTH_TOKEN blank to disable execution.
JUDGE0_URL=
JUDGE0_AUTH_TOKEN=
JUDGE0_POSTGRES_PASSWORD=
JUDGE0_REDIS_PASSWORD=
JUDGE0_PORT=2358
REALTIME_HOST=127.0.0.1
REALTIME_PORT=3001
REALTIME_URL=ws://127.0.0.1:3001
REALTIME_HTTP_URL=http://127.0.0.1:3001
# Generate independent random secrets with the command below; keep them server-only.
REALTIME_TOKEN_SECRET=replace_with_an_independent_random_secret_of_at_least_32_characters
REALTIME_INTERNAL_SECRET=replace_with_another_independent_random_secret_of_at_least_32_characters
REALTIME_MAX_DOCUMENT_BYTES=8388608
REALTIME_MAX_MESSAGE_BYTES=1048576

# S3-compatible image storage. Uploads are disabled until the bucket and keys are set.
# All storage requests pass through the server; the bucket can remain private.
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_SESSION_TOKEN=
S3_FORCE_PATH_STYLE=false

# Generate a secret with: node -p "require('node:crypto').randomBytes(32).toString('hex')"
BETTER_AUTH_URL=http://127.0.0.1:3000
BETTER_AUTH_SECRET=replace_with_a_random_secret_of_at_least_32_characters

# Optional until you configure each provider's OAuth application.
# Callback: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Callback: <BETTER_AUTH_URL>/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
