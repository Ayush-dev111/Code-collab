{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [".env"],
  "globalEnv": ["NEXT_PUBLIC_SENTRY_DSN"],
  "globalPassThroughEnv": [
    "DATABASE_URL",
    "REDIS_URL",
    "SENTRY_DSN",
    "NEXT_PUBLIC_SENTRY_DSN",
    "SENTRY_ENVIRONMENT",
    "SENTRY_AUTH_TOKEN",
    "SENTRY_ORG",
    "SENTRY_PROJECT",
    "JUDGE0_URL",
    "JUDGE0_AUTH_TOKEN",
    "REALTIME_HOST",
    "REALTIME_PORT",
    "REALTIME_URL",
    "REALTIME_HTTP_URL",
    "REALTIME_TOKEN_SECRET",
    "REALTIME_INTERNAL_SECRET",
    "REALTIME_MAX_DOCUMENT_BYTES",
    "REALTIME_MAX_MESSAGE_BYTES",
    "S3_ENDPOINT",
    "S3_REGION",
    "S3_BUCKET",
    "S3_ACCESS_KEY_ID",
    "S3_SECRET_ACCESS_KEY",
    "S3_SESSION_TOKEN",
    "S3_FORCE_PATH_STYLE",
    "BETTER_AUTH_URL",
    "BETTER_AUTH_SECRET",
    "GOOGLE_CLIENT_ID",
    "GOOGLE_CLIENT_SECRET",
    "GITHUB_CLIENT_ID",
    "GITHUB_CLIENT_SECRET"
  ],
  "tasks": {
    "generate": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "@collab/db#build": {
      "dependsOn": ["^build", "generate"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "@collab/db#typecheck": {
      "dependsOn": ["build"],
      "outputs": []
    }
  }
}
