{
  "name": "@collab/realtime",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=../../.env dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@collab/db": "workspace:*",
    "@collab/shared": "workspace:*",
    "@collab/server": "workspace:*",
    "@hocuspocus/server": "4.7.0",
    "socket.io": "4.8.4",
    "y-protocols": "1.0.7",
    "yjs": "13.6.33"
  },
  "devDependencies": {
    "@collab/config": "workspace:*",
    "@types/node": "24.19.1",
    "typescript": "6.0.3"
  }
}
