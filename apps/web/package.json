{
  "name": "@collab/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/next.ts dev --hostname 127.0.0.1 --port 3000",
    "build": "node scripts/next.ts build",
    "start": "node scripts/next.ts start --hostname 127.0.0.1 --port 3000",
    "typecheck": "next typegen && tsc --noEmit",
    "test:phase1": "node --env-file=../../.env scripts/phase1-smoke.ts",
    "test:phase3": "node --env-file=../../.env scripts/phase3-smoke.ts",
    "test:phase3:browser": "node --env-file=../../.env scripts/phase3-browser-smoke.ts",
    "test:phase3:restart": "node --env-file=../../.env scripts/phase3-restart-smoke.ts",
    "test:phase3:storage": "node --env-file=../../.env scripts/phase3-storage-smoke.ts",
    "test:phase4": "node --env-file=../../.env scripts/phase3-smoke.ts --phase4",
    "test:phase4:browser": "node --env-file=../../.env scripts/phase3-browser-smoke.ts --phase4",
    "test:phase5": "node --env-file=../../.env scripts/phase3-smoke.ts --phase5",
    "test:phase5:browser": "node --env-file=../../.env scripts/phase3-browser-smoke.ts --phase5",
    "test:phase5:restart": "node --env-file=../../.env scripts/phase3-restart-smoke.ts --phase5",
    "test:phase6": "node --env-file=../../.env scripts/phase6-smoke.ts",
    "test:phase6:browser": "node --env-file=../../.env scripts/phase6-smoke.ts --browser",
    "test:phase6:sandbox": "node --env-file=../../.env scripts/phase6-smoke.ts --sandbox --browser",
    "test:phase7": "node --env-file=../../.env scripts/phase7-smoke.ts",
    "test:phase7:browser": "node --env-file=../../.env scripts/phase7-smoke.ts --browser",
    "test:phase8": "node --env-file=../../.env scripts/phase8-test.ts",
    "test:phase8:fixtures": "node --env-file=../../.env scripts/phase8-test.ts --redis-fixture"
  },
  "dependencies": {
    "@blocknote/core": "0.55.0",
    "@blocknote/react": "0.55.0",
    "@blocknote/shadcn": "0.55.0",
    "@collab/db": "workspace:*",
    "@collab/shared": "workspace:*",
    "@collab/server": "workspace:*",
    "@hocuspocus/provider": "4.7.0",
    "@monaco-editor/react": "4.7.0",
    "@tanstack/react-query": "5.104.1",
    "better-auth": "1.7.7",
    "clsx": "2.1.1",
    "monaco-editor": "0.57.0",
    "next": "16.3.8",
    "@sentry/nextjs": "11.5.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "redis": "6.3.0",
    "socket.io-client": "4.8.4",
    "tailwind-merge": "3.7.0",
    "y-monaco": "0.1.6",
    "yjs": "13.6.33",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@collab/config": "workspace:*",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
