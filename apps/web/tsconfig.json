{
  "extends": "@collab/config/next.json",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "paths": {
      "@/*": ["./*"],
      "monaco-editor/esm/vs/editor/editor.api.js": [
        "./node_modules/monaco-editor/esm/vs/editor.d.ts"
      ],
      "monaco-editor/esm/vs/editor/editor.api": [
