{
  "name": "collab-platform",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=22.0.0 <25"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "infra:up": "docker compose --env-file .env -f infra/docker-compose.yml up -d --wait",
    "infra:down": "docker compose --env-file .env -f infra/docker-compose.yml down",
    "runner:up": "docker compose --env-file .env -f infra/docker-compose.yml --profile runner up -d --wait judge0 judge0-workers",
    "runner:down": "docker compose --env-file .env -f infra/docker-compose.yml --profile runner stop judge0 judge0-workers judge0-db judge0-redis",
    "db:generate": "turbo run generate",
    "db:migrate": "pnpm db:generate && pnpm --filter @collab/db migrate",
    "db:migrate:deploy": "pnpm db:generate && pnpm --filter @collab/db migrate:deploy",
    "db:status": "pnpm db:generate && pnpm --filter @collab/db migrate:status",
    "db:studio": "pnpm db:generate && pnpm --filter @collab/db studio",
    "db:verify": "turbo run build --filter=@collab/db && pnpm --filter @collab/db verify",
    "test:phase1": "turbo run build --filter=@collab/db && pnpm --filter @collab/web test:phase1",
    "test:phase3": "turbo run build --filter=@collab/db && pnpm --filter @collab/web test:phase3",
    "test:phase3:browser": "turbo run build --filter=@collab/db && pnpm --filter @collab/web test:phase3:browser",
    "test:phase3:restart": "turbo run build --filter=@collab/realtime && pnpm --filter @collab/web test:phase3:restart",
    "test:phase3:storage": "pnpm --filter @collab/web test:phase3:storage",
    "test:phase4": "turbo run build --filter=@collab/db && pnpm --filter @collab/web test:phase4",
    "test:phase4:browser": "turbo run build --filter=@collab/db && pnpm --filter @collab/web test:phase4:browser",
    "test:phase5": "turbo run build --filter=@collab/db && pnpm --filter @collab/web test:phase5",
    "test:phase5:browser": "turbo run build --filter=@collab/db && pnpm --filter @collab/web test:phase5:browser",
    "test:phase5:restart": "turbo run build --filter=@collab/realtime && pnpm --filter @collab/web test:phase5:restart",
    "test:phase6": "turbo run build --filter=@collab/realtime && pnpm --filter @collab/web test:phase6",
    "test:phase6:browser": "turbo run build --filter=@collab/realtime && pnpm --filter @collab/web test:phase6:browser",
    "test:phase6:sandbox": "turbo run build --filter=@collab/realtime && pnpm --filter @collab/web test:phase6:sandbox",
    "test:phase7": "turbo run build --filter=@collab/realtime && pnpm --filter @collab/web test:phase7",
    "test:phase7:browser": "turbo run build --filter=@collab/realtime && pnpm --filter @collab/web test:phase7:browser",
    "test:phase8": "turbo run build --filter=@collab/realtime && pnpm --filter @collab/web test:phase8",
    "test:phase8:fixtures": "turbo run build --filter=@collab/realtime && pnpm --filter @collab/web test:phase8:fixtures",
    "test:monitoring": "turbo run build --filter=@collab/server && pnpm --filter @collab/server test:monitoring"
  },
  "devDependencies": {
    "@collab/config": "workspace:*",
    "@types/node": "24.19.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "prettier": "3.9.9",
    "turbo": "2.11.7",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1"
  }
}
